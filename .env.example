# Telegram BotFather token
BOT_TOKEN=123456:ABCDEF_your_bot_token_here

# Your Telegram numeric ID. Example: 123456789
# You can add several admins separated by commas: 123,456,789
ADMIN_IDS=123456789

# Warehouse employees Telegram IDs. Admins also have warehouse access.
WAREHOUSE_IDS=

# Courier employees Telegram IDs. Admins also have courier access.
COURIER_IDS=

# Bot/company display name
COMPANY_NAME=CargoPilot Pro

# Storage. For Docker/VPS you can use /data
DATA_DIR=.
DB_PATH=./cargo_ai_crm.sqlite3

# Health check server port for Render/Koyeb/VPS
PORT=8080

# Currency sign for reports/calculator. Usually $ for cargo tariffs or ₸ for local accounting.
CURRENCY=₸

# Partner commission percent for report calculation
PARTNER_COMMISSION_PERCENT=5

# Region/package mode. Use CIS for СНГ.
REGION_MODE=CIS

# Free auto status engine. Changes cargo statuses by route schedule without paid APIs.
AUTO_STATUS_ENABLED=true
AUTO_STATUS_INTERVAL_SECONDS=300
