BOT_TOKEN=your_bot_token_from_BotFather
ADMIN_IDS=your_telegram_id
WAREHOUSE_IDS=
COURIER_IDS=

COMPANY_NAME=CargoPilot Pro
DATA_DIR=/data
DB_PATH=/data/cargopilot.sqlite3
PORT=8080
CURRENCY=₸

PARTNER_COMMISSION_PERCENT=5
REGION_MODE=CIS

AUTO_STATUS_ENABLED=true
AUTO_STATUS_INTERVAL_SECONDS=300
AUTO_STATUS_TIME_UNIT=days
AUTO_STATUS_ON_NEW_ORDERS=false

# Public URL of your Railway/Render/Koyeb service.
# Needed so clients receive direct cargo tracking links after creating an order.
PUBLIC_BASE_URL=https://cargopilotprobot-production.up.railway.app

# CargoPilot SmartFlow
ISSUE_STALE_HOURS=24
OWNER_REPORT_ENABLED=false
OWNER_REPORT_INTERVAL_SECONDS=86400
BOT_USERNAME=CargoPilotProBot

# CargoPilot TrustFlow
TRUSTFLOW_ENABLED=true
TRUSTFLOW_GRACE_HOURS=12
BOT_USERNAME=CargoPilotProBot

# Demo virtual bank payments
DEMO_PAYMENT_ENABLED=true
DEMO_PAYMENT_AMOUNT=10000

# Auto statuses start only after payment confirmation
AUTO_STATUS_AFTER_PAYMENT_ONLY=true

# CargoPromise OS
PROMISE_OS_ENABLED=true
PROMISE_STALE_HOURS=24
PROMISE_HIGH_TRACK_VIEWS=5
